# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="CA Marketplace"
APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ca_marketplace
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ca_marketplace

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Required for Firebase Auth login. ID token from Firebase has aud = this Web client ID.
# Find it: Google Cloud Console → your project (same as Firebase) → APIs & Services →
# Credentials → "Web client (auto created by Google Service)" → copy Client ID.
FIREBASE_WEB_CLIENT_ID=

# ─── Firebase (frontend Google sign-in; from Firebase Console > Project settings) ─
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── OTP Provider (Twilio) ─────────────────────────────────────────────────────
OTP_PROVIDER=twilio
OTP_EXPIRY_SECONDS=300

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+14846421722

# ─── Payment Provider ─────────────────────────────────────────────────────────
# razorpay = live/test checkout; mock = fake orders (or omit Razorpay keys in development — API falls back to mock).
PAYMENT_PROVIDER=razorpay

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Same key ID as above — needed for Dockerized Next (docker-compose passes this into the browser checkout).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Meeting Provider ─────────────────────────────────────────────────────────
MEETING_PROVIDER=google_meet

GOOGLE_MEET_CLIENT_ID=your-google-meet-client-id
GOOGLE_MEET_CLIENT_SECRET=your-google-meet-client-secret
GOOGLE_MEET_REFRESH_TOKEN=your-google-meet-refresh-token

# ─── Platform Config ──────────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=10
GST_PERCENT=18
CA_SUBSCRIPTION_FEE=4999
SUBSCRIPTION_VALIDITY_DAYS=365

# ─── ICAI Verification ────────────────────────────────────────────────────────
ICAI_LOM_URL=http://112.133.194.254/lom.asp
ICAI_VERIFICATION_FUZZY_THRESHOLD=85
ICAI_VERIFICATION_MAX_RETRIES=3

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
